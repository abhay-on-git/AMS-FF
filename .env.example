# ─── AMS API Configuration ────────────────────────────────────────────────────
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must never be committed.
#
# VITE_API_URL
#   Base URL for the backend REST API (no trailing slash).
#   Example: http://localhost:3000/api/v1
#
VITE_API_URL=http://localhost:3000/api/v1

# VITE_API_MOCK
#   Set to "true" to run entirely on in-memory mock data (no backend needed).
#   Set to "false" to connect to the real API at VITE_API_URL.
#   Switch modes without changing any consuming code.
#
VITE_API_MOCK=true
